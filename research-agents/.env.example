# Pooled Neon main connection used by runtime and dashboard.
DATABASE_URL=
# Direct Neon main connection used only by migrations/admin checks.
DIRECT_DATABASE_URL=
# Optional Neon management API token; never put a PostgreSQL URL here.
NEON_PG_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=main
TAVILY_API_KEY=
# Optional secondary key; used only after a quota, rate-limit, auth, or provider failure.
TAVILY_API_KEY_2=
TAVILY_PROJECT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Optional app-controlled free fallbacks. Leave empty for strict Gemma-only mode.
# --allow-free-fallbacks uses the built-in capability-filtered free chain.
OPENROUTER_FALLBACK_MODELS=
RESEARCH_TIMEZONE=Europe/Lisbon
SHEPERD_ROOT=
LLM_MAX_CALLS=32
LLM_MAX_INPUT_CHARS=350000
LLM_MAX_OUTPUT_TOKENS=3000
MAX_RUN_SECONDS=900
