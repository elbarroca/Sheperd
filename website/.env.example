# Contact form delivery stays off outside the Netlify production context.
NEXT_PUBLIC_CONTACT_DELIVERY_ENABLED=false

# Keep audit intake disabled until its sender, privacy notice, abuse controls,
# and bounded delivery test are approved.
FORM_DELIVERY_ENABLED=false
NEXT_PUBLIC_AUDIT_DELIVERY_ENABLED=false

# Server-only secret. Never expose it with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
SHEPERD_AUDIT_FROM_EMAIL=SheperD Website <audits@sheperd.io>
SHEPERD_AUDIT_TO_EMAIL=info@sheperd.io
