# Keep both flags false until the sender domain, recipient, privacy notice,
# abuse controls, and one bounded delivery test are approved.
FORM_DELIVERY_ENABLED=false
NEXT_PUBLIC_AUDIT_DELIVERY_ENABLED=false

# Pilot intake stays unavailable in this release. Both flags must remain false.
PILOT_DELIVERY_ENABLED=false
NEXT_PUBLIC_PILOT_DELIVERY_ENABLED=false
SHEPERD_PILOT_FROM_EMAIL=
SHEPERD_PILOT_TO_EMAIL=

# Server-only secret. Never expose it with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
SHEPERD_AUDIT_FROM_EMAIL=SheperD Website <audits@sheperd.io>
SHEPERD_AUDIT_TO_EMAIL=info@sheperd.io
